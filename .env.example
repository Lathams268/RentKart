# ---------------------------------------------------------------------------
# RentKart environment variables
# Copy this file to `.env` (config.py loads it automatically) and fill in the
# values you need. Every secret is read from the environment - nothing is
# hard-coded in the application. Never commit your real `.env`.
# The complete list of every variable the app reads (104 of them, including
# the REVENUE_* feature flags) is in README.md, section 4.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# SQLite by default, so local development needs no database server. On Render
# paste the PostgreSQL "Internal Database URL" instead:
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
# A legacy postgres:// prefix is converted to postgresql:// automatically.
DATABASE_URL=sqlite:///rentkart.db
# Seed the demo catalogue on startup, but only while the database is empty.
# Default: on when RENDER=true, off locally (use `python seed.py` there).
# AUTO_SEED=True
HOST=0.0.0.0
PORT=5000
DEBUG=True
APP_BASE_URL=http://localhost:5000

# --- Sessions / cookies -----------------------------------------------------
SESSION_DAYS=14
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False        # set True when serving over HTTPS

# --- Auth rate limits (per IP, sliding window) ------------------------------
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_LOGIN=20
AUTH_RATE_LIMIT_SIGNUP=10
AUTH_RATE_LIMIT_OTP=30

# --- OTP / phone verification ----------------------------------------------
# console = print the code to the server log (development, no SMS sent)
# sms     = send through the provider selected by SMS_PROVIDER
# demo    = legacy fixed DEMO_OTP for the phone-login demo accounts
OTP_MODE=console
DEMO_OTP=1234
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_MAX_SENDS=5
OTP_SEND_WINDOW_MINUTES=60
OTP_LOCK_MINUTES=15
DEFAULT_COUNTRY_CODE=IN
DEFAULT_COUNTRY_DIAL=+91

# --- SMS provider (used only when OTP_MODE=sms) -----------------------------
# msg91 (default, India) | twilio | fast2sms
SMS_PROVIDER=msg91
SMS_SENDER_ID=RENTKT
# Fast2SMS (legacy India route)
SMS_API_KEY=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
# Twilio (E.164 numbers; From is TWILIO_PHONE_NUMBER or a Messaging Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# MSG91 Flow API: needs a DLT-approved template whose variable receives the OTP
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_VARIABLE=OTP

# --- Listing photos (see README "Listing photos") --------------------------
# local = files in MEDIA_FOLDER served from /static/media (default)
# s3 | cloudinary = cloud storage; set the matching block below
# When CLOUDINARY_URL is set, photos are stored on Cloudinary automatically.
MEDIA_BACKEND=local
# MEDIA_FOLDER defaults to <repo>/static/media
# MEDIA_FOLDER=/var/lib/rentkart/media
PHOTO_MAX_MB=5
PHOTO_MAX_PER_ITEM=6
PHOTO_LARGE_PX=1600
PHOTO_THUMB_PX=600
PHOTO_JPEG_QUALITY=82
# S3 (MEDIA_BACKEND=s3, needs: pip install boto3)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN/custom domain, e.g. https://cdn.example.com
S3_PUBLIC_BASE_URL=
# Cloudinary (free tier). Either set CLOUDINARY_URL - the "API Environment
# Variable" from the Cloudinary dashboard (cloudinary://key:secret@cloud_name),
# which is enough on its own - or the three values below with
# MEDIA_BACKEND=cloudinary. Requires: pip install cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (verification codes, booking confirmations, receipts) ------------
# console = log the message (default); smtp = send real mail
EMAIL_PROVIDER=console
MAIL_FROM=no-reply@rentkart.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True

# --- Checkout money ---------------------------------------------------------
# Platform fee charged to the renter (% of rent, clamped by min/max)
RENTER_FEE_PERCENT=0
RENTER_FEE_MIN=0
RENTER_FEE_MAX=50
# Tax on the rent (GST %). 0 hides the "Taxes" line.
TAX_PERCENT=0

# --- Payments ---------------------------------------------------------------
# mock = built-in demo gateway (no money moves); razorpay = real gateway.
# razorpay falls back to mock with a log warning when the keys are missing.
PAYMENT_MODE=mock
# Use TEST keys (rzp_test_...) until you are ready to go live. Never commit them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same secret in the Razorpay dashboard webhook settings.
RAZORPAY_WEBHOOK_SECRET=

# --- UPI QR (optional) ------------------------------------------------------
# Leave empty to show a clearly fake demo@rentkart QR on the payment page.
UPI_ID=
UPI_PAYEE_NAME=RentKart

# --- TrustShield (optional) -------------------------------------------------
TRUSTSHIELD_ENABLED=True
# When unset, damage comparison runs locally with Pillow only (no external AI).
VISION_API_KEY=
MAX_PHOTO_MB=6
MAX_VIDEO_MB=40

# --- Tools (optional) -------------------------------------------------------
# Only needed for tools/fetch_stock_photos.py (Pexels API).
# tools/fetch_seed_photos.py needs no key - it downloads the curated demo set.
PEXELS_API_KEY=
